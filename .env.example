# Pesapal credentials — get these from your Pesapal merchant dashboard
# Sandbox: https://cybqa.pesapal.com/pesapalv3
# Live:    https://pay.pesapal.com/v3
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=your_consumer_key_here
PESAPAL_CONSUMER_SECRET=your_consumer_secret_here

# The public HTTPS URL of THIS backend once deployed (Pesapal needs to reach it for IPN callbacks)
# e.g. https://linda-mwananchi-api.onrender.com
BACKEND_PUBLIC_URL=https://your-backend-url.example.com

# Where to send the donor back to after paying (your site's donation page)
FRONTEND_RETURN_URL=https://your-site.example.com/thank-you

# Server port
PORT=4000
